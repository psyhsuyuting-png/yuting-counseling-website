:root{--ink:#34281f;--muted:#725f4e;--paper:#fffaf0;--sand:#f6e8cf;--clay:#8a5f3d;--line:rgba(91,65,46,.18);--ocean:#5c7f8e}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);background:var(--paper);font-family:"Noto Sans TC","PingFang TC",sans-serif;line-height:1.85;letter-spacing:.025em}.article-header{min-height:72px;padding:12px clamp(20px,5vw,72px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);background:rgba(255,250,240,.94)}a{color:var(--clay);text-decoration-thickness:1px;text-underline-offset:4px}.article-brand{font-family:"Noto Serif TC",serif;color:var(--ink);text-decoration:none;font-weight:700}.article-brand span{display:inline-grid;place-items:center;width:30px;height:30px;margin-right:8px;border-radius:50%;background:var(--sand);color:var(--ocean)}.article-main,.listing-main{width:min(1120px,calc(100% - 40px));margin:0 auto}.article-main article{width:min(760px,100%);margin:80px auto 48px}.article-kicker{color:var(--clay);font-size:.78rem;font-weight:700;letter-spacing:.18em;text-transform:uppercase}.article-main h1,.listing-main h1{font-family:"Noto Serif TC",serif;line-height:1.28;letter-spacing:.05em;font-size:clamp(2rem,5vw,3.55rem);margin:.3em 0}.article-deck,.listing-intro{font-size:1.12rem;color:var(--muted);max-width:700px}.article-date,.post-meta{font-size:.82rem;color:#8b735e}.article-hero{width:100%;max-height:520px;object-fit:cover;border-radius:28px;margin:36px 0;box-shadow:0 18px 55px rgba(74,51,35,.12)}.article-body{font-size:1.04rem}.article-body h2{font-family:"Noto Serif TC",serif;font-size:1.65rem;margin-top:2.4em}.article-body h3{font-size:1.2rem;margin-top:2em}.article-body p{margin:1.35em 0}.article-body blockquote{margin:2em 0;padding:1px 0 1px 24px;border-left:3px solid var(--clay);color:var(--muted)}.article-return{width:min(760px,100%);margin:0 auto 80px;padding-top:24px;border-top:1px solid var(--line);display:flex;justify-content:space-between}.listing-main{padding:80px 0}.post-list{display:grid;gap:24px;margin-top:48px}.post-card{display:grid;grid-template-columns:minmax(220px,34%) 1fr;gap:28px;padding:22px;border:1px solid var(--line);border-radius:24px;background:#fffdf8}.post-card img,.article-cover-placeholder{width:100%;height:220px;object-fit:cover;border-radius:16px;background:linear-gradient(135deg,var(--sand),#e6d0b2)}.post-card h2{font-family:"Noto Serif TC",serif;line-height:1.4;margin:.25em 0}.post-card h2 a{color:var(--ink);text-decoration:none}.read-more{font-weight:700}footer{padding:28px 20px;text-align:center;border-top:1px solid var(--line);color:var(--muted);font-size:.85rem}@media(max-width:680px){.article-header{align-items:flex-start;gap:16px}.post-card{grid-template-columns:1fr}.article-main article,.listing-main{margin-top:50px}.article-return{flex-direction:column;gap:16px}.article-body{font-size:1rem}}
